#!/usr/bin/with-contenv bashio
# =============================================================================
#  Smart City Poles - initialisation
#  1. Renders the energy-experiment package and the control automation from
#     the add-on options into /config/packages/
#  2. Makes sure configuration.yaml loads the packages directory
#  3. Validates the config and reloads (or asks for a restart)
# =============================================================================

CONFIG_DIR="/config"
PKG_DIR="${CONFIG_DIR}/packages"
CONF_YAML="${CONFIG_DIR}/configuration.yaml"
ENERGY_TPL="/usr/src/kolones_energy.yaml.tpl"
AUTOMATION_TPL="/usr/src/kolones_automation.yaml.tpl"
INFLUXDB_TPL="/usr/src/kolones_influxdb.yaml.tpl"
GRAFANA_SRC="/usr/src/grafana"
ENERGY_PKG="${PKG_DIR}/smart_city_poles_energy.yaml"
AUTOMATION_PKG="${PKG_DIR}/smart_city_poles_automation.yaml"
INFLUXDB_PKG="${PKG_DIR}/smart_city_poles_influxdb.yaml"
GPROV="/share/grafana-provisioning"

HA_API="http://supervisor/core/api"

# -----------------------------------------------------------------------------
# Helpers
# -----------------------------------------------------------------------------
ha_notify() {
    # $1 = message (single line, no double quotes)
    curl -sS -X POST \
        -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        -H "Content-Type: application/json" \
        -d "{\"title\": \"Smart City Poles\", \"notification_id\": \"smart_city_poles_setup\", \"message\": \"$1\"}" \
        "${HA_API}/services/persistent_notification/create" > /dev/null || true
}

render() {
    # $1 = template, $2 = destination
    sed -e "s|__LIGHT1__|${LIGHT1}|g" \
        -e "s|__LIGHT2__|${LIGHT2}|g" \
        -e "s|__LIGHT3__|${LIGHT3}|g" \
        -e "s|__PRESENCE1__|${PRESENCE1}|g" \
        -e "s|__PRESENCE2__|${PRESENCE2}|g" \
        -e "s|__PRESENCE3__|${PRESENCE3}|g" \
        -e "s|__LUX_SENSOR__|${LUX_SENSOR}|g" \
        -e "s|__SHELLY_ENERGY__|${SHELLY_ENERGY}|g" \
        -e "s|__START_DATE__|${START_DATE}|g" \
        "$1" > "$2"
}

write_if_changed() {
    # $1 = rendered source, $2 = destination. Returns 0 when it wrote (changed).
    if [ -f "$2" ] && cmp -s "$1" "$2"; then
        rm -f "$1"
        return 1
    fi
    mv "$1" "$2"
    return 0
}

# -----------------------------------------------------------------------------
# Read options
# -----------------------------------------------------------------------------
INSTALL_AUTOMATION=$(bashio::config 'install_automation')
INSTALL_ENERGY=$(bashio::config 'install_energy_package')
LIGHT1=$(bashio::config 'light_pole_1')
LIGHT2=$(bashio::config 'light_pole_2')
LIGHT3=$(bashio::config 'light_pole_3')
PRESENCE1=$(bashio::config 'presence_pole_1')
PRESENCE2=$(bashio::config 'presence_pole_2')
PRESENCE3=$(bashio::config 'presence_pole_3')
LUX_SENSOR=$(bashio::config 'lux_sensor')
SHELLY_ENERGY=$(bashio::config 'shelly_energy_entity')
START_DATE=$(bashio::config 'experiment_start_date')
INSTALL_INFLUXDB=$(bashio::config 'install_influxdb')
INSTALL_GRAFANA=$(bashio::config 'install_grafana')
INFLUX_USER=$(bashio::config 'influx_reader_user')
INFLUX_PASS=$(bashio::config 'influx_reader_password')

NEEDS_RESTART=0
CHANGED=0

mkdir -p "${PKG_DIR}"


# -----------------------------------------------------------------------------
# 1. Energy package (helpers + meters + sensors)
# -----------------------------------------------------------------------------
if bashio::var.true "${INSTALL_ENERGY}"; then
    render "${ENERGY_TPL}" "${ENERGY_PKG}.tmp"
    if write_if_changed "${ENERGY_PKG}.tmp" "${ENERGY_PKG}"; then
        bashio::log.info "Energy package written to ${ENERGY_PKG}"
        CHANGED=1
    else
        bashio::log.info "Energy package unchanged."
    fi
else
    if [ -f "${ENERGY_PKG}" ]; then
        bashio::log.warning "install_energy_package is off - removing ${ENERGY_PKG}"
        rm -f "${ENERGY_PKG}"
        CHANGED=1
        NEEDS_RESTART=1
    fi
fi

# -----------------------------------------------------------------------------
# 2. Control automation (needs the helpers from the energy package)
# -----------------------------------------------------------------------------
if bashio::var.true "${INSTALL_AUTOMATION}"; then
    if bashio::var.false "${INSTALL_ENERGY}"; then
        bashio::log.warning "The automation needs the helpers (input_select.kolones_mode, counter, timers). Make sure they exist - e.g. from a manual install of the energy package."
    fi
    render "${AUTOMATION_TPL}" "${AUTOMATION_PKG}.tmp"
    if write_if_changed "${AUTOMATION_PKG}.tmp" "${AUTOMATION_PKG}"; then
        bashio::log.info "Control automation written to ${AUTOMATION_PKG}"
        CHANGED=1
    else
        bashio::log.info "Control automation unchanged."
    fi
else
    if [ -f "${AUTOMATION_PKG}" ]; then
        bashio::log.warning "install_automation is off - removing ${AUTOMATION_PKG}"
        rm -f "${AUTOMATION_PKG}"
        CHANGED=1
        NEEDS_RESTART=1
    fi
fi

# -----------------------------------------------------------------------------
# 2b. InfluxDB package (long-term storage for Grafana) - needs a full restart
# -----------------------------------------------------------------------------
if bashio::var.true "${INSTALL_INFLUXDB}"; then
    cp "${INFLUXDB_TPL}" "${INFLUXDB_PKG}.tmp"
    if write_if_changed "${INFLUXDB_PKG}.tmp" "${INFLUXDB_PKG}"; then
        bashio::log.info "InfluxDB package written to ${INFLUXDB_PKG}"
        bashio::log.warning "InfluxDB loads at boot only - a full Home Assistant restart is required. Also make sure secrets.yaml contains influxdb_password."
        CHANGED=1
        NEEDS_RESTART=1
    else
        bashio::log.info "InfluxDB package unchanged."
    fi
else
    if [ -f "${INFLUXDB_PKG}" ]; then
        bashio::log.warning "install_influxdb is off - removing ${INFLUXDB_PKG}"
        rm -f "${INFLUXDB_PKG}"
        CHANGED=1
        NEEDS_RESTART=1
    fi
fi

# -----------------------------------------------------------------------------
# 2c. Grafana provisioning kit (datasource + 29-panel dashboard) in /share
# -----------------------------------------------------------------------------
if bashio::var.true "${INSTALL_GRAFANA}"; then
    mkdir -p "${GPROV}/datasources" "${GPROV}/dashboards"
    GRAFANA_CHANGED=0

    sed -e "s#__INFLUX_USER__#${INFLUX_USER}#g" -e "s#__INFLUX_PASS__#${INFLUX_PASS}#g" \
        "${GRAFANA_SRC}/datasource.yaml.tpl" > "${GPROV}/datasources/kolones.yaml.tmp"
    write_if_changed "${GPROV}/datasources/kolones.yaml.tmp" "${GPROV}/datasources/kolones.yaml" && GRAFANA_CHANGED=1

    cp "${GRAFANA_SRC}/dashboards_provider.yaml" "${GPROV}/dashboards/_provider.yaml.tmp"
    write_if_changed "${GPROV}/dashboards/_provider.yaml.tmp" "${GPROV}/dashboards/_provider.yaml" && GRAFANA_CHANGED=1

    sed 's|${DS_INFLUXDB}|influxdb-kolones|g' "${GRAFANA_SRC}/kolones-patras.json" > "${GPROV}/dashboards/kolones-patras.json.tmp"
    write_if_changed "${GPROV}/dashboards/kolones-patras.json.tmp" "${GPROV}/dashboards/kolones-patras.json" && GRAFANA_CHANGED=1

    if [ "${GRAFANA_CHANGED}" -eq 1 ]; then
        bashio::log.info "Grafana provisioning files written to ${GPROV}"
        ha_notify "Grafana: τα αρχεία provisioning γράφτηκαν στο /share/grafana-provisioning. Στο add-on Grafana πρόσθεσε στο configuration: env_vars -> name GF_PATHS_PROVISIONING, value /share/grafana-provisioning και κάνε restart το Grafana. Θα βρεις το dashboard «Εξυπνες Κολωνες - Πατρα» στον φάκελο Smart City Poles."
    else
        bashio::log.info "Grafana provisioning files unchanged."
    fi
else
    if [ -d "${GPROV}" ]; then
        bashio::log.warning "install_grafana is off - removing ${GPROV} (restart the Grafana add-on to unload the dashboard)"
        rm -rf "${GPROV}"
    fi
fi

# -----------------------------------------------------------------------------
# 3. Make sure configuration.yaml includes the packages directory
# -----------------------------------------------------------------------------
if [ "${CHANGED}" -eq 1 ] && [ -f "${CONF_YAML}" ]; then
    if grep -qE '^[[:space:]]*packages:[[:space:]]*!include_dir_(named|merged)[[:space:]]+packages' "${CONF_YAML}"; then
        bashio::log.info "configuration.yaml already loads the packages directory"
    else
        BACKUP="${CONF_YAML}.smart-poles-backup-$(date +%Y%m%d-%H%M%S)"
        bashio::log.warning "configuration.yaml does not load packages - backing up to ${BACKUP} and adding the include"
        cp "${CONF_YAML}" "${BACKUP}"
        if grep -q '^homeassistant:' "${CONF_YAML}"; then
            awk '/^homeassistant:/ && !done { print; print "  packages: !include_dir_named packages"; done=1; next } { print }' \
                "${CONF_YAML}" > "${CONF_YAML}.tmp" && mv "${CONF_YAML}.tmp" "${CONF_YAML}"
        else
            printf '\nhomeassistant:\n  packages: !include_dir_named packages\n' >> "${CONF_YAML}"
        fi
        # The homeassistant: block is only read at boot
        NEEDS_RESTART=1
    fi
fi

# -----------------------------------------------------------------------------
# 4. Validate configuration and reload / ask for restart
# -----------------------------------------------------------------------------
if [ "${CHANGED}" -eq 1 ]; then
    bashio::log.info "Checking Home Assistant configuration..."
    CHECK=$(curl -sS -X POST -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
        "${HA_API}/config/core/check_config" || echo '{"result":"unknown"}')
    RESULT=$(echo "${CHECK}" | jq -r '.result // "unknown"')
    ERRORS=$(echo "${CHECK}" | jq -r '.errors // empty' | head -c 600)

    if [ "${RESULT}" = "valid" ]; then
        if [ "${NEEDS_RESTART}" -eq 1 ]; then
            bashio::log.warning "Configuration valid. A full Home Assistant restart is required."
            ha_notify "Τα αρχεία των Smart City Poles εγκαταστάθηκαν στο /config/packages/ και το configuration.yaml ενημερώθηκε (backup δίπλα του). Χρειάζεται **μία πλήρη επανεκκίνηση** του Home Assistant (Settings > System > Restart) για να φορτώσουν τα packages."
        else
            bashio::log.info "Configuration valid - reloading..."
            curl -sS -X POST -H "Authorization: Bearer ${SUPERVISOR_TOKEN}" \
                "${HA_API}/services/homeassistant/reload_all" > /dev/null || true
            ha_notify "Τα packages των Smart City Poles (ενέργεια + αυτοματισμός) εγκαταστάθηκαν και φορτώθηκαν χωρίς restart. Δες τα entities kolones_* και τον αυτοματισμό «Κολόνες - Πλήρης έλεγχος»."
        fi
    else
        bashio::log.error "Configuration check failed: ${ERRORS}"
        ha_notify "ΠΡΟΣΟΧΗ: το check configuration απέτυχε μετά την εγκατάσταση των Smart City Poles. Σφάλμα: ${ERRORS:-άγνωστο}. Δες το log του add-on, διόρθωσε τις ρυθμίσεις (Configuration tab) και κάνε restart το add-on."
    fi
else
    bashio::log.info "Nothing to install (both install options are off) - dashboard only."
fi

bashio::log.info "Smart City Poles initialisation finished."
