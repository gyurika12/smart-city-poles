# =============================================================================
#  SMART CITY POLES - FULL CONTROL AUTOMATION
#  Auto-generated by the "Smart City Poles" add-on. Do NOT edit - it is
#  re-rendered from the add-on options on every start.
#  Day/night + wave (pre-light) + baseline/adaptive scenarios, for
#  __POLE_COUNT__ pole(s).
# =============================================================================

automation:
  - id: smart_city_poles_control
    alias: Κολόνες - Πλήρης έλεγχος
    description: Ημέρα/νύχτα + κύμα + πείραμα εξοικονόμησης ενέργειας
    mode: queued
    max: 50

    variables:
      # Brightness levels (0-255), from the add-on options (percentages)
      fos_vasi:     __BRI_BASE__       # night, nobody around (adaptive)
      fos_kyma:     __BRI_WAVE__       # a NEIGHBOURING pole detected (pre-light)
      fos_boost:    __BRI_BOOST__      # THIS pole detected
      fos_baseline: __BRI_BASELINE__   # baseline scenario, all night

      # alternate = even/odd day of the year, adaptive / baseline = fixed
      scenario_cfg: __SCENARIO__
      energy_enabled: __ENERGY_ENABLED__
      hold: "__HOLD__"

      oles: __ALL_LIGHTS__

      # Per presence sensor: its lamp, its timer and its neighbours' lamps and
      # timers. Without the neighbours' timers a lamp raised by the wave would
      # never return to the base level.
      poles: __POLES_MAP__

      # Timer -> lamp it brings back to base
      timer_lights: __TIMERS_MAP__

    triggers:
      - trigger: numeric_state
        entity_id: __LUX_SENSOR__
        above: __LUX_DAY__
        for: "00:00:10"
        id: mera
      - trigger: numeric_state
        entity_id: __LUX_SENSOR__
        below: __LUX_NIGHT__
        for: "00:00:10"
        id: vradu
      - trigger: homeassistant
        event: start
        id: restart
      - trigger: state
        entity_id: __PRESENCE_LIST__
        to: "on"
        id: presence
      - trigger: state
        entity_id: __TIMER_LIST__
        from: active
        to: idle
        id: timer

    conditions: []

    actions:
      - choose:

          # ================= DAY: everything off =================
          - conditions:
              - condition: or
                conditions:
                  - condition: trigger
                    id: mera
                  - condition: and
                    conditions:
                      - condition: trigger
                        id: restart
                      - condition: numeric_state
                        entity_id: __LUX_SENSOR__
                        above: __LUX_DAY__
            sequence:
              # Store the night's pass count under the right scenario
              - if:
                  - condition: trigger
                    id: mera
                then:
                  - action: input_number.set_value
                    target:
                      entity_id: >
                        {{ 'input_number.kolones_passes_last_baseline'
                           if is_state('input_select.kolones_mode','baseline')
                           else 'input_number.kolones_passes_last_adaptive' }}
                    data:
                      value: "{{ states('counter.kolones_passes_night') | int(0) }}"
              - action: light.turn_off
                target:
                  entity_id: "{{ oles }}"
                data:
                  transition: 10

          # ============ NIGHT: pick the scenario and start ============
          - conditions:
              - condition: or
                conditions:
                  - condition: trigger
                    id: vradu
                  - condition: and
                    conditions:
                      - condition: trigger
                        id: restart
                      - condition: numeric_state
                        entity_id: __LUX_SENSOR__
                        below: __LUX_NIGHT__
            sequence:
              # On restart the scenario is NOT re-picked, so a night is never
              # split between two scenarios.
              - if:
                  - condition: trigger
                    id: vradu
                then:
                  - variables:
                      senario: >
                        {% if scenario_cfg in ['adaptive', 'baseline'] %}{{ scenario_cfg }}
                        {% else %}{{ 'adaptive' if (now().timetuple().tm_yday % 2 == 0)
                                     else 'baseline' }}{% endif %}
                  - action: input_select.select_option
                    target:
                      entity_id: input_select.kolones_mode
                    data:
                      option: "{{ senario | trim }}"
                  # Switch the energy meters to the matching tariff
                  - if:
                      - condition: template
                        value_template: "{{ energy_enabled }}"
                    then:
                      - action: select.select_option
                        target:
                          entity_id:
                            - select.kolones_energy
                            - select.kolones_energy_daily
                        data:
                          option: "{{ senario | trim }}"
                  - action: counter.reset
                    target:
                      entity_id: counter.kolones_passes_night
                  - action: logbook.log
                    data:
                      name: Κολόνες
                      message: "Νύχτα σε σενάριο {{ senario | trim | upper }}"

              - action: light.turn_on
                target:
                  entity_id: "{{ oles }}"
                data:
                  brightness: >
                    {{ fos_baseline if is_state('input_select.kolones_mode','baseline')
                       else fos_vasi }}
                  transition: 3

          # ====== DETECTION: boost + WAVE to the neighbours ======
          # Adaptive scenario only - in baseline the lamps are at full
          # brightness all night and detections are ignored.
          - conditions:
              - condition: trigger
                id: presence
              - condition: state
                entity_id: input_select.kolones_mode
                state: adaptive
              - condition: template
                value_template: "{{ is_state(poles[trigger.entity_id].light, 'on') }}"
            sequence:
              - variables:
                  pole: "{{ poles[trigger.entity_id] }}"
              # 1. The pole that detected -> boost
              - action: light.turn_on
                target:
                  entity_id: "{{ pole.light }}"
                data:
                  brightness: "{{ fos_boost }}"
                  transition: 1
              # 2. THE WAVE: neighbours -> pre-light, but only those below the
              #    wave level, so a lamp already boosted is not dimmed.
              - variables:
                  raise: >
                    {% set ns = namespace(l=[]) %}
                    {% for e in pole.neighbor_lights %}
                      {% if (state_attr(e,'brightness') or 0) < fos_kyma %}
                        {% set ns.l = ns.l + [e] %}
                      {% endif %}
                    {% endfor %}
                    {{ ns.l }}
              - if:
                  - condition: template
                    value_template: "{{ raise | count > 0 }}"
                then:
                  - action: light.turn_on
                    target:
                      entity_id: "{{ raise }}"
                    data:
                      brightness: "{{ fos_kyma }}"
                      transition: 1
              # 3. Return-to-base timers - for the pole AND its neighbours
              - action: timer.start
                target:
                  entity_id: "{{ [pole.timer] + pole.neighbor_timers }}"
                data:
                  duration: "{{ hold }}"
              # 4. Count the pass (validity check of the experiment)
              - action: counter.increment
                target:
                  entity_id: counter.kolones_passes_night

          # ============ TIMER FINISHED: back to base ============
          - conditions:
              - condition: trigger
                id: timer
              - condition: state
                entity_id: input_select.kolones_mode
                state: adaptive
              - condition: template
                value_template: "{{ is_state(timer_lights[trigger.entity_id], 'on') }}"
            sequence:
              - action: light.turn_on
                target:
                  entity_id: "{{ timer_lights[trigger.entity_id] }}"
                data:
                  brightness: "{{ fos_vasi }}"
                  transition: 5
