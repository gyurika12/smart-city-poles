# =============================================================================
#  SMART CITY POLES - ENERGY EXPERIMENT PACKAGE
#  Auto-generated by the "Smart City Poles" add-on.
#  Do NOT edit this file - it is re-rendered from the add-on options on every
#  add-on start. Change the options in the add-on Configuration tab instead.
# =============================================================================

# The helpers (input_select.kolones_mode, counters, timers) live in
# smart_city_poles_helpers.yaml.

# -----------------------------------------------------------------------------
# 2. ENERGY WITH TWO TARIFFS - ONE PER SCENARIO
#  The automation flips select.kolones_energy(_daily) between baseline/adaptive
#  so the same Shelly measurement is split per scenario.
# -----------------------------------------------------------------------------
utility_meter:
  kolones_energy:
    source: __SHELLY_ENERGY__
    tariffs: [baseline, adaptive]

  kolones_energy_daily:
    source: __SHELLY_ENERGY__
    cycle: daily
    tariffs: [baseline, adaptive]

# -----------------------------------------------------------------------------
# 3. HOURS PER SCENARIO (nights have different lengths - mean power is what
#    matters, not raw kWh)
# -----------------------------------------------------------------------------
sensor:
  - platform: history_stats
    name: Kolones Hours Baseline
    entity_id: input_select.kolones_mode
    state: "baseline"
    type: time
    start: "{{ as_timestamp(strptime('__START_DATE__', '%Y-%m-%d')) | timestamp_local }}"
    end: "{{ now() }}"

  - platform: history_stats
    name: Kolones Hours Adaptive
    entity_id: input_select.kolones_mode
    state: "adaptive"
    type: time
    start: "{{ as_timestamp(strptime('__START_DATE__', '%Y-%m-%d')) | timestamp_local }}"
    end: "{{ now() }}"

# -----------------------------------------------------------------------------
# 4. DERIVED SENSORS: mean power per scenario + the saving percentage
# -----------------------------------------------------------------------------
template:
  - sensor:
      - name: "Kolones Avg W Baseline"
        unique_id: kolones_avg_w_baseline
        unit_of_measurement: "W"
        device_class: power
        state: >
          {% set e = states('sensor.kolones_energy_baseline') | float(0) %}
          {% set h = states('sensor.kolones_hours_baseline') | float(0) %}
          {{ (e / h * 1000) | round(1) if h > 0.1 else 0 }}

      - name: "Kolones Avg W Adaptive"
        unique_id: kolones_avg_w_adaptive
        unit_of_measurement: "W"
        device_class: power
        state: >
          {% set e = states('sensor.kolones_energy_adaptive') | float(0) %}
          {% set h = states('sensor.kolones_hours_adaptive') | float(0) %}
          {{ (e / h * 1000) | round(1) if h > 0.1 else 0 }}

      - name: "Kolones Saving Pct"
        unique_id: kolones_saving_pct
        unit_of_measurement: "%"
        icon: mdi:leaf
        state: >
          {% set b = states('sensor.kolones_avg_w_baseline') | float(0) %}
          {% set a = states('sensor.kolones_avg_w_adaptive') | float(0) %}
          {{ ((b - a) / b * 100) | round(1) if b > 0 else 0 }}
        attributes:
          baseline_w: "{{ states('sensor.kolones_avg_w_baseline') }}"
          adaptive_w: "{{ states('sensor.kolones_avg_w_adaptive') }}"
          hours_baseline: "{{ states('sensor.kolones_hours_baseline') }}"
          hours_adaptive: "{{ states('sensor.kolones_hours_adaptive') }}"

      - name: "Kolones Avg Brightness"
        unique_id: kolones_avg_brightness
        unit_of_measurement: "bri"
        state: >
          {% set l = __ALL_LIGHTS__ %}
          {{ (l | map('state_attr','brightness')
                | map('int', 0) | sum / (l | count)) | round(0) }}
